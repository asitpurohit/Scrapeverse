{
  "manifest_version": 3,
  "name": "ScrapeVerse — Universal E-commerce Companion",
  "version": "1.0.0",
  "description": "Injects live price history charts directly below Buy buttons on Shopify, WooCommerce, and Magento stores with AI review summaries and similar product discovery.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*",
    "https://scrapeverse.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ScrapeVerse E-commerce Companion"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["backend-config.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
