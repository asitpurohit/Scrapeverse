# ScrapeVerse Environment Configuration
PORT=3001

# Bright Data API & Scraper Studio
BRIGHTDATA_API_KEY=your_brightdata_api_token_here

# Optional LLM API for RAG Review Summarization (OpenAI / Anthropic / Gemini)
LLM_API_KEY=your_llm_api_key_here
LLM_PROVIDER=gemini # 'gemini', 'openai', or 'anthropic'

# Resend transactional email alerts
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=ScrapeVerse Alerts <onboarding@resend.dev>

# Database Configuration (SQLite local or Postgres URL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/scrapeverse

# Estimated traffic uplift for visitors without the extension
TRAFFIC_UPLIFT_PERCENT=50
